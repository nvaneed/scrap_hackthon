long motorPos  = 0;    // motor position in half-steps (0 = 12:00)
long savedPos  = 0;
char label[32] = "";   // city the clock is set to ("" = custom time)

unsigned long lastMillis = 0;
unsigned long lastStepUs = 0;
unsigned long lastSaveMs = 0;
unsigned long lastPubMs  = 0;
