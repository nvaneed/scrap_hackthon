// ---------- Web (runs in its own task on core 0) ----------
bool readTimeArgs(int64_t &out) {
  if (!server.hasArg("h") || !server.hasArg("m")) return false;
  int h = server.arg("h").toInt();
  int m = server.arg("m").toInt();
  int s = server.hasArg("s") ? server.arg("s").toInt() : 0;
  if (h < 0 || h > 23 || m < 0 || m > 59 || s < 0 || s > 59) return false;
  out = clockMs(h, m, s);
  return true;
}

void queueWebCommand(bool calibrate) {
  int64_t t;
  if (!readTimeArgs(t)) {
    server.send(400, "application/json", "{\"ok\":false}");
    return;
  }

  char name[32];
  size_t n = 0;
  String raw = server.arg("name");
  for (size_t i = 0; i < raw.length() && n < sizeof(name) - 1; i++) {
    char ch = raw[i];
    if (ch >= 32 && ch <= 126 && ch != '"' && ch != '\\' && ch != '<' && ch != '>')
      name[n++] = ch;
  }
  name[n] = 0;

  portENTER_CRITICAL(&mux);
  webTarget = t;
  webCal    = calibrate;
  memcpy(webLabel, name, n + 1);
  webCmd    = true;
  portEXIT_CRITICAL(&mux);

  server.send(200, "application/json", "{\"ok\":true}");
}

void handleStatus() {
  long shown, remain;
  char name[32];
  portENTER_CRITICAL(&mux);
  shown  = pubShown;
  remain = pubRemain;
  memcpy(name, pubLabel, sizeof(name));
  portEXIT_CRITICAL(&mux);

  char json[128];
  snprintf(json, sizeof(json), "{\"shown\":%ld,\"remain\":%ld,\"label\":\"%s\"}",
           shown, remain, name);
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", json);
}

void webTask(void *) {
  server.on("/",       []() { server.send_P(200, "text/html; charset=utf-8", INDEX_HTML); });
  server.on("/go",     []() { queueWebCommand(false); });
  server.on("/cal",    []() { queueWebCommand(true); });
  server.on("/status", handleStatus);
  server.onNotFound([]() { server.send(404, "text/plain", "Not found"); });
  server.begin();

  for (;;) {
    server.handleClient();
    vTaskDelay(2);
  }
}

// ---------- loop() side of the sharing ----------
void takeWebCommand() {
  bool have, cal = false;
  int64_t t = 0;
  char name[32];

  portENTER_CRITICAL(&mux);
  have = webCmd;
  if (have) {
    cal = webCal;
    t = webTarget;
    memcpy(name, webLabel, sizeof(name));
    webCmd = false;
  }
  portEXIT_CRITICAL(&mux);

  if (!have) return;
  if (cal) calibrateTo(t);
  else     goTo(t, name);
}

void publish() {
  int64_t hands = stepsToMs(motorPos);
  long shown  = (long)mod12(hands);
  long remain = (long)(dialMs - hands);

  portENTER_CRITICAL(&mux);
  pubShown  = shown;
  pubRemain = remain;
  memcpy(pubLabel, label, sizeof(pubLabel));
  portEXIT_CRITICAL(&mux);
}

void checkWiFi(unsigned long nowMs) {
  static bool online = false, mdnsOn = false;
  static unsigned long lastCheck = 0, offlineSince = 0;
  if (nowMs - lastCheck < 1000) return;
  lastCheck = nowMs;

  bool up = (WiFi.status() == WL_CONNECTED);
  if (up && !online) {
    if (!mdnsOn && MDNS.begin(HOSTNAME)) {
      MDNS.addService("http", "tcp", 80);
      mdnsOn = true;
    }
    printAddress();
  }
  if (!up) {
    if (online) {
      Serial.println("Wi-Fi lost, retrying...");
      offlineSince = nowMs;
    } else if (nowMs - offlineSince > 30000) {
      WiFi.reconnect();
      offlineSince = nowMs;
    }
  }
  online = up;
}

// ---------- Main ----------
void setup() {
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  releaseCoils();

  Serial.begin(115200);
  delay(500);

  prefs.begin("clock", false);
  if (prefs.isKey("pos")) {
    motorPos = prefs.getLong("pos", 0);
    dialMs = stepsToMs(motorPos);
    printDial("Remembered: hands are at ");
  } else {
    motorPos = msToSteps(clockMs(START_HOUR, START_MIN, 0));
    prefs.putLong("pos", motorPos);
    dialMs = stepsToMs(motorPos);
    printDial("First start: hands assumed at ");
  }
  if (prefs.isKey("label")) prefs.getString("label", label, sizeof(label));
  savedPos = motorPos;
  publish();

  // Wi-Fi connects in the background; the clock keeps running meanwhile
  WiFi.persistent(false);
  WiFi.setHostname(HOSTNAME);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.printf("Connecting to Wi-Fi \"%s\"...\n", WIFI_SSID);

  // Web server on core 0, so loading the page never stalls the motor (loop is on core 1)
  xTaskCreatePinnedToCore(webTask, "web", 8192, nullptr, 1, nullptr, 0);

  Serial.println("Send 10:30 to go there, c11:30 if hands are really at 11:30, ? for status.");
  lastMillis = millis();
  lastSaveMs = lastMillis;
}

void loop() {
  readSerial();
  takeWebCommand();

  // Advance the clock by the real time that has passed
  unsigned long nowMs = millis();
  dialMs += (unsigned long)(nowMs - lastMillis);
  lastMillis = nowMs;

  long diff = msToSteps(dialMs) - motorPos;
  unsigned long nowUs = micros();

  if (diff != 0) {
    unsigned long gap = nowUs - lastStepUs;
    if (gap >= stepUs) {
      int dir = (diff > 0) ? 1 : -1;
      // New direction, or loop was held up (flash save etc.): start slowly again
      if (dir != lastDir || gap > stepUs + 2000UL) { stepUs = START_US; lastDir = dir; }

      stepMotor(dir);
      lastStepUs = nowUs;

      stepUs = (stepUs > FAST_US + RAMP_US) ? stepUs - RAMP_US : FAST_US;
      if (diff > 1 || diff < -1) moving = true;
    }
  } else {
    stepUs = START_US;
    if (coilsOn && nowUs - lastStepUs > 20000UL) releaseCoils();
    if (moving) {
      moving = false;
      savePosition();
      printDial("Arrived. Running normally at ");
    }
  }

  // Save position regularly so it survives a power cut
  if (nowMs - lastSaveMs >= SAVE_EVERY_MS) {
    lastSaveMs = nowMs;
    savePosition();
  }

  // Share the hand position with the web page
  if (nowMs - lastPubMs >= 100) {
    lastPubMs = nowMs;
    publish();
  }

  checkWiFi(nowMs);
}
