    const p=parts(c.f,d);
    const off=Math.round((Date.UTC(p.y,p.mo-1,p.d,p.h,p.mi,p.s)-base)/60000)-my;
    const day=p.h>=6&&p.h<18;
    c.hm.textContent=(p.h%12||12)+':'+pad(p.mi);
    c.ap.textContent=p.h<12?'AM':'PM';
    c.dn.textContent=day?'☀️':'🌙';
    c.el.classList.toggle('night',!day);
    c.off.textContent=c.home?'Your zone':offText(off);
    const dd=Date.UTC(p.y,p.mo-1,p.d)-today;
    c.day.textContent=dd>0?'Tomorrow':dd<0?'Yesterday':'Today';
  }
};
const filter=()=>{
  const q=$('q').value.trim().toLowerCase();let n=0;
  for(const c of cards){
    const inRegion=c.home?region==='All':(region==='All'||c.region===region);
    const ok=inRegion&&(!q||(c.name+' '+c.country).toLowerCase().includes(q));
    c.el.hidden=!ok;if(ok)n++;
  }
  $('empty').hidden=n>0;
};

/* ---- talking to the clock ---- */
const send=async(url,msg,el)=>{
  if(el)el.classList.add('sending');
  try{const r=await fetch(url,{cache:'no-store'});if(!r.ok)throw 0;toast(msg);peak=0;poll();}
  catch(e){toast('Couldn’t reach the clock',1);}
  if(el)el.classList.remove('sending');
};
const goCity=c=>{
  const p=parts(c.f,new Date());
  send('/go?h='+p.h+'&m='+p.mi+'&s='+p.s+'&name='+encodeURIComponent(c.name),'Going to '+c.name+' · '+fmt12(p.h,p.mi),c.el);
};
const setHands=ms=>{
  const hrs=ms/3600000;
  if(cum===null){cum=disp=hrs;return;}
  let d=hrs-(((cum%12)+12)%12);
  if(d>6)d-=12;if(d<-6)d+=12;
  cum+=d;
};
const render=(s,moving)=>{
  setHands(s.shown);
  const h=Math.floor(s.shown/3600000)||12,m=Math.floor(s.shown/60000)%60;
  $('digital').textContent=h+':'+pad(m);
  if(!calSet){$('tCal').value=pad(h)+':'+pad(m);calSet=true;}
  $('hero').classList.toggle('moving',moving);
  if(moving){
    const a=Math.abs(s.remain);peak=Math.max(peak,a);
    $('state').textContent=(s.remain>0?'Moving forward':'Moving backward')+' · '+dur(a)+' to go';
    $('bar').style.width=(peak?100*(1-a/peak):0)+'%';
  }else{
    peak=0;$('state').textContent='Running normally';$('bar').style.width='0%';
  }
  if(s.label!==lastLabel){
    lastLabel=s.label;
    const c=cards.find(x=>x.name===s.label);
    const fs=$('hflag');fs.textContent='';fs.appendChild(flagEl(c||null,true));
    $('hname').textContent=c?c.name:'Custom time';
    $('hsub').textContent=c?(c.home?'Your time zone':c.country):'Set by hand';
    for(const x of cards)x.el.classList.toggle('active',x===c);
  }
};
const poll=async()=>{
  const my=++seq;clearTimeout(timer);let moving=false;
  try{
    const r=await fetch('/status',{cache:'no-store'});const s=await r.json();
    if(my!==seq)return;
    conn(true);moving=Math.abs(s.remain)>2000;render(s,moving);
  }catch(e){if(my!==seq)return;conn(false);}
  timer=setTimeout(poll,moving?300:1500);
};

/* ---- build the page ---- */
(()=>{
  let s='';
  for(let i=0;i<60;i++){
    const a=i*Math.PI/30,b=i%5===0,r2=b?73:80,sn=Math.sin(a),cs=Math.cos(a);
    s+=`<line class='${b?'T':'t'}' x1='${(100+85*sn).toFixed(2)}' y1='${(100-85*cs).toFixed(2)}' x2='${(100+r2*sn).toFixed(2)}' y2='${(100-r2*cs).toFixed(2)}'/>`;
  }
  [[12,0],[3,90],[6,180],[9,270]].forEach(([n,g])=>{
    const a=g*Math.PI/180;
    s+=`<text class='num' x='${(100+61*Math.sin(a)).toFixed(1)}' y='${(100-61*Math.cos(a)).toFixed(1)}'>${n}</text>`;
  });
  $('ticks').innerHTML=s;
})();

const myTz=Intl.DateTimeFormat().resolvedOptions().timeZone||'UTC';
const list=[{name:'Your time',country:myTz.replace(/_/g,' '),cc:'',tz:myTz,region:'',home:true}]
  .concat(CITIES.map(a=>({name:a[0],country:a[1],cc:a[2],tz:a[3],region:a[4]})));
for(const c of list){
