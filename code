const HH=$('hh'),MH=$('mh');
const anim=()=>{
  if(cum!==null){
    disp+=(cum-disp)*0.18;if(Math.abs(cum-disp)<1e-4)disp=cum;
    MH.setAttribute('transform','rotate('+(disp*360).toFixed(2)+' 100 100)');
    HH.setAttribute('transform','rotate('+(disp*30).toFixed(2)+' 100 100)');
