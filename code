// ---------- Time <-> steps ----------
int64_t floorDiv(int64_t a, int64_t b) {
  int64_t q = a / b;
  if ((a % b != 0) && (a < 0)) q--;
  return q;
}

int64_t ceilDiv(int64_t a, int64_t b) {
  int64_t q = a / b;
  if ((a % b != 0) && (a > 0)) q++;
  return q;
}

long msToSteps(int64_t ms) {
  return (long)floorDiv(ms * HALF_STEPS_PER_REV_X1000, MS_X1000);
}

int64_t stepsToMs(long steps) {
  return ceilDiv((int64_t)steps * MS_X1000, HALF_STEPS_PER_REV_X1000);
}

int64_t mod12(int64_t t) {
  return ((t % MS_PER_12H) + MS_PER_12H) % MS_PER_12H;
}

int64_t clockMs(int h, int m, int s) {
  return (((int64_t)(h % 12) * 60 + m) * 60 + s) * 1000LL;
}

// ---------- Motor ----------
void writeCoils(uint8_t a, uint8_t b, uint8_t c, uint8_t d) {
  digitalWrite(IN1, a);
  digitalWrite(IN2, b);
  digitalWrite(IN3, c);
  digitalWrite(IN4, d);
}

void stepMotor(int dir) {
  motorPos += dir;
  long p = FLIP_DIRECTION ? -motorPos : motorPos;
  const uint8_t *s = SEQ[((p % 8) + 8) % 8];
  writeCoils(s[0], s[1], s[2], s[3]);
  coilsOn = true;
}

void releaseCoils() {               // keeps the motor cool between ticks
  writeCoils(0, 0, 0, 0);
  coilsOn = false;
}

// ---------- Memory ----------
void savePosition() {
  if (motorPos != savedPos) {
    prefs.putLong("pos", motorPos);
    savedPos = motorPos;
  }
}

void setLabel(const char *name) {
  if (strcmp(label, name) == 0) return;
  strlcpy(label, name, sizeof(label));
  prefs.putString("label", label);
}

// ---------- Display ----------
void printDial(const char *text) {
  int64_t t = mod12(dialMs);
  int totalMin = (int)(t / 60000);
  int h = totalMin / 60;
  if (h == 0) h = 12;
  Serial.printf("%s%d:%02d\n", text, h, totalMin % 60);
}

void printAddress() {
  if (WiFi.status() == WL_CONNECTED)
    Serial.printf("Web page: http://%s   or   http://%s.local\n",
                  WiFi.localIP().toString().c_str(), HOSTNAME);
  else
    Serial.printf("Wi-Fi: not connected yet (looking for \"%s\")\n", WIFI_SSID);
}

// ---------- Moves ----------
void goTo(int64_t target, const char *name) {
  int64_t move = target - mod12(dialMs);   // 0 to <12 h forward
  if (move < 0) move += MS_PER_12H;
  if (SHORTEST_WAY && move > MS_PER_12H / 2) move -= MS_PER_12H;

  dialMs += move;
  setLabel(name);

  long mins = (long)((move < 0 ? -move : move) / 60000);
  printDial("Going to ");
  Serial.printf("  (%s %ld h %ld min)%s%s\n", move >= 0 ? "forward" : "backward",
                mins / 60, mins % 60, *name ? "  for " : "", name);
}

void calibrateTo(int64_t target) {    // hands are physically here: just remember it
  dialMs   = target;
  motorPos = msToSteps(target);
  moving   = false;
  savePosition();
  setLabel("");
  printDial("OK, hands set at ");
}

// ---------- Serial commands ----------
void handleCommand(char *s) {
  while (*s == ' ') s++;

  if (*s == '?') { printDial("Clock shows "); printAddress(); return; }

  bool calibrate = false;
  if (*s == 'c' || *s == 'C') { calibrate = true; s++; }

  int h, m;
  if (sscanf(s, "%d:%d", &h, &m) != 2 || h < 0 || h > 23 || m < 0 || m > 59) {
    Serial.println("Use H:MM like 10:30  (c11:30 = hands are at 11:30, ? = show time)");
    return;
  }

  if (calibrate) calibrateTo(clockMs(h, m, 0));
  else           goTo(clockMs(h, m, 0), "");
}

void readSerial() {
  while (Serial.available()) {
    char ch = Serial.read();
    lastCharMs = millis();
    if (ch == '\n' || ch == '\r') {
      if (bufLen) { buf[bufLen] = 0; handleCommand(buf); bufLen = 0; }
    } else if (bufLen < sizeof(buf) - 1) {
      buf[bufLen++] = ch;
    }
  }
  // Also works when the Serial Monitor is set to "No line ending"
  if (bufLen && millis() - lastCharMs > 50) {
    buf[bufLen] = 0; handleCommand(buf); bufLen = 0;
  }
}

